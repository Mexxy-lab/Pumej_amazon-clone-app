pipeline {
    agent any

    options {
        timeout(time: 15, unit: 'MINUTES') // Slightly increased for safety
    }

    environment {
        AWS_REGION = "ap-south-1"

        // Jenkins-managed AWS credentials.
        AWS_ACCESS_KEY_ID     = credentials('pumej_aws_access_id')
        AWS_SECRET_ACCESS_KEY = credentials('pumej_aws_secret_key')

        // Amazon ECR Public registry and repository.
        ECR_REGISTRY = "public.ecr.aws"
        ECR_REPOSITORY = "p9c7s9q0/pumejrepo"
    }

    stages {
        stage('SCM Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Mexxy-lab/Pumej_amazon-clone-app.git'
            }
        }
        stage('Set Image Tag') {
            steps {
                script {
                    env.IMAGE_TAG = "v${env.BUILD_NUMBER}.0"
                }
            }
        }         

        stage('SonarQube Code Analysis') {
            steps {
                script {
                    // Get the scanner installation configured in Jenkins.
                    def scannerHome = tool 'SonarScanner'

                    // Connect to the configured SonarQube server.
                    withSonarQubeEnv('SonarQube-Local') {
                        sh """
                            # Start the SonarQube source-code analysis.
                            echo "Starting SonarQube scan..."

                            # Run the scanner using sonar-project.properties.
                            ${scannerHome}/bin/sonar-scanner
                        """
                    }
                }
            }
        }
        stage('SonarQube Quality Gate') {
            steps {
                // Wait up to five minutes for SonarQube to process the analysis.
                timeout(time: 5, unit: 'MINUTES') {
                    // Fail the pipeline if the Quality Gate is not passed.
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                // Retrieve Docker Hub credentials from Jenkins.
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        # Prevent credentials from being printed.
                        set +x

                        # Authenticate to Docker Hub for base image pulls.
                        echo "$DOCKERHUB_TOKEN" | docker login \
                            --username "$DOCKERHUB_USERNAME" \
                            --password-stdin

                        # Build the application image.
                        docker build --network=host \
                            -t "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG" .

                        # Remove Docker Hub login credentials after building.
                        docker logout
                    '''
                }
            }
        }
        // Login to Amazon ECR Public before pushing the Docker image.
        // Region for Amazon ECR Public authentication is us-east-1.
        stage('Login to ECR') {
            steps {
                sh '''
                    # Authenticate to Amazon ECR Public.
                    # ECR Public authentication uses us-east-1.
                    set +x

                    echo "Logging into Amazon ECR Public..."

                    aws ecr-public get-login-password \
                        --region us-east-1 | \
                        docker login \
                            --username AWS \
                            --password-stdin "$ECR_REGISTRY"
                '''
            }
        }

        stage('Trivy Scan (Aqua)') {
            steps {
                sh '''
                    echo "Running Trivy vulnerability scan..."

                    trivy image \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --timeout 10m \
                        "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"
                '''
            }
        }

        stage('Push Docker Image to ECR') {
            steps {
                sh '''
                    echo "Pushing Docker image to Amazon ECR Public..."

                    docker push \
                        "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"
                '''
            }
        }

        stage('Trigger ManifestUpdate') {
            steps {
                build job: 'argocd-manifest-amazon', parameters: [
                    string(name: 'DOCKERTAG', value: "${IMAGE_TAG}")
                ]
            }
        }
    }

    post {
        always {
            echo "✅ Build Deployed Successfully, downstream job triggered!"
        }
    }
}
